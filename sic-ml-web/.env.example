# PostgreSQL local (el mismo servidor que ves en DBeaver / psql).
# Crea la base sic_ml y ejecuta postgres-local/001...006.sql antes.
DATABASE_URL=postgresql://sicml:cambia_esta_clave@127.0.0.1:5432/sic_ml
# URL privada del servicio FastAPI IDS; solo la usa el servidor Next.js.
IDS_INFERENCE_URL=http://127.0.0.1:8088
# URL privada del servicio FastAPI anti-phishing (phishing/api.py); solo la usa el servidor Next.js.
PHISHING_API_URL=http://127.0.0.1:8089
# Opcional: misma clave que PHISHING_API_KEY del servicio Python (cabecera x-api-key).
# PHISHING_API_KEY=

# --- Correo (SMTP) para enviar credenciales desde el panel /equipo ---
# Sin SMTP_HOST no se envía correo: el panel muestra la contraseña una sola vez al admin.
#
# Prueba local sin Docker (los correos quedan en logs/mail-catch.txt):
#   .venv/bin/pip install aiosmtpd
#   .venv/bin/python sic-ml-web/scripts/smtp-dev.py        # 127.0.0.1:1025
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_FROM=SIC-ML <no-reply@sic-ml.lab.local>
# APP_URL=http://localhost:3000
#
# Gmail real (necesita "contraseña de aplicación" de Google, no la normal):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587          # o 465 con SMTP_SECURE=true
# SMTP_SECURE=false
# SMTP_USER=tu-cuenta@gmail.com
# SMTP_PASS=contraseña-de-aplicacion-de-16-caracteres
# SMTP_FROM=tu-cuenta@gmail.com

